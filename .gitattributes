# Text is LF in the repository and in working copies (overrides a local core.autocrlf); Git decides
# what is text. Agents and containers write and expect LF.
* text=auto eol=lf

# Windows shells need CRLF (cmd.exe mis-parses labels and `goto` in LF batch files).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
