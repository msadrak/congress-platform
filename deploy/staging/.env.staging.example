# Congress Platform staging/production environment. Copy to .staging/staging.env (git-ignored) or let
# `node scripts/staging/stack.mjs init` generate one with fresh secrets. Every <...> placeholder is
# refused by the API at startup; never commit the filled-in file.
#
# Every setting the API reads is listed here (scripts/staging/stack.test.mjs checks it). A setting left empty
# means "use the default" given in its comment; values must be bare (no trailing comments).

# staging | production — both enforce explicit database, media root and a generated admin token.
CONGRESS_ENVIRONMENT=staging

# Host directory for database, uploads and Caddy state (DrGibi-style ~/drgibi-persistent-data).
# `stack.mjs init` sets this to ${HOME}/congress-persistent-data (or $CONGRESS_PERSISTENT_DATA_ROOT when set while
# running init). On a server you may use /opt/congress-persistent-data. Never share it with another stack: the root
# docker-compose.yml development database uses ${HOME}/congress-dev-data instead.
CONGRESS_PERSISTENT_DATA_ROOT=<set by stack.mjs init>

# ── Secrets (generated by `stack.mjs init`; never reuse them between installs) ─────────────────────────
# PostgreSQL password (hex/url-safe characters only; it is embedded in the database URL).
POSTGRES_PASSWORD=<generate: python -c "import secrets; print(secrets.token_hex(24))">
# Organizer provisioning credential (>= 32 chars) and JWT signing secret (>= 32 chars).
CONGRESS_PLATFORM_ADMIN_TOKEN=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
CONGRESS_JWT_SECRET=<generate: python -c "import secrets; print(secrets.token_hex(32))">
# Encrypts credentials stored in the database (the sms.ir key saved in the platform console). >= 32 chars and
# different from CONGRESS_JWT_SECRET. Empty = a key derived from the JWT secret. An existing install adds one with
# `stack.mjs init --add-missing`; values sealed before keep opening.
CONGRESS_SECRET_BOX_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">

# ── Public addresses ──────────────────────────────────────────────────────────────────────────────────
# The origin visitors use: canonical links, Open Graph URLs and CORS.
CONGRESS_PUBLIC_ORIGIN=https://localhost:8443
# Optional: origin of the pass links in SMS (`<origin>/t/<code>`, ADR 0015); empty = CONGRESS_PUBLIC_ORIGIN. Only for a
# shorter https domain served by this same deployment (also list it in CONGRESS_SITE_ADDRESS).
CONGRESS_SHORT_LINK_ORIGIN=

# Caddy site address and certificate issuer.
#   local staging : https://localhost + internal (Caddy's local CA; trust .staging/caddy-root.crt to remove warnings)
#   real domain   : congress.example.org + an e-mail address (automatic Let's Encrypt/ZeroSSL), ports 443/80
CONGRESS_SITE_ADDRESS=https://localhost
CONGRESS_TLS=internal
# on = also serve plain http://localhost (local staging); off = real domain, HTTP redirects to HTTPS. Default on.
CONGRESS_LOCAL_HTTP=on
# on = Strict-Transport-Security (only with a public certificate on the final domain). Default off.
CONGRESS_HSTS=off
# Client ranges that may reach /api/organizers and /api/platform through Caddy. Default private_ranges;
# a hosted server uses 127.0.0.1/32 (nobody; operators use `stack.mjs organizer ...`).
CONGRESS_ADMIN_ALLOW=private_ranges

# Host binding. Keep 127.0.0.1 for local staging; a server uses 0.0.0.0 with 443/80.
#   Phones on the same Wi-Fi: run `node scripts/staging/stack.mjs lan` (again after changing networks); it detects
#   this computer's address and sets the four values below. `lan off` returns to localhost only.
#   LAN access (phones on the same Wi-Fi): CONGRESS_BIND=0.0.0.0,
#   CONGRESS_SITE_ADDRESS=https://localhost, https://<machine-ip>, CONGRESS_DEFAULT_SNI=<machine-ip>
#   (clients send no SNI to a bare IP) and CONGRESS_PUBLIC_ORIGIN=https://<machine-ip>:8443
CONGRESS_BIND=127.0.0.1
CONGRESS_DEFAULT_SNI=localhost
CONGRESS_HTTPS_PORT=8443
CONGRESS_HTTP_PORT=18080
# Image alias the services run (`stack.mjs up` also tags every build with its commit for rollback).
CONGRESS_IMAGE_TAG=staging
# CONGRESS_APP_BUILD: release id built into the web bundle (scanner build label, version-drift warning). `stack.mjs up`
# sets it for every build (short commit, -dirty-<time> for uncommitted changes); do not set it here.

# CDN in front (docs/deployment/CDN.md): written by `stack.mjs cdn ...`, all off by default.
#   CONGRESS_CDN=off  CONGRESS_CDN_ONLY=off  CONGRESS_TRUSTED_PROXIES=  CONGRESS_CLIENT_IP_HEADER=X-Forwarded-For
#   CONGRESS_ORIGIN_TLS=on

# ── SMS ───────────────────────────────────────────────────────────────────────────────────────────────
# console = nothing is sent; codes are read back with `node scripts/staging/stack.mjs sms-code <mobile>`
# (what the automated staging checks use). smsir = real SMS from your sms.ir service line (خط خدماتی): set the
# API key and the line number here or in the platform console (/platform), which overrides these values. The
# message wording is edited in the app (organizer → SMS; platform console → SMS).
CONGRESS_SMS_PROVIDER=console
CONGRESS_SMSIR_API_KEY=
CONGRESS_SMSIR_LINE_NUMBER=
# Seconds a send waits for sms.ir (a sign-in request waits for it). Default 5.
CONGRESS_SMSIR_TIMEOUT_SECONDS=
# Platform-wide SMS caps per rolling hour / day, 0 = no cap. Defaults 2000 / 20000. The platform console overrides them.
CONGRESS_SMS_HOURLY_CAP=
CONGRESS_SMS_DAILY_CAP=
# Percent of each platform cap kept for sign-in codes (0-90): every other SMS stops at the rest. Default 20.
CONGRESS_SMS_OTP_RESERVE_PERCENT=
# SMS notices an attendee's own changes can trigger, per person per rolling hour and per ticket per rolling day
# (defaults 6 / 6); above them cancelling works without a text and registering again answers 429.
CONGRESS_SMS_NOTICES_PER_ATTENDEE_PER_HOUR=
CONGRESS_SMS_NOTICES_PER_TICKET_PER_DAY=
# Organizer changes that text an attendee (cancel/reissue/transfer with a notice), per organizer per rolling hour.
# Default 300; above it the change answers 429 SMS_NOTICE_LIMIT_REACHED.
CONGRESS_SMS_NOTICES_PER_ORGANIZER_PER_HOUR=
# Organizer test sends per organizer per rolling 24 h. Default 20.
CONGRESS_SMS_TEST_SENDS_PER_ORGANIZER_PER_DAY=
# Provider calls in flight per API process. Default 8.
CONGRESS_SMS_MAX_CONCURRENT_SENDS=
# Background delivery of queued SMS (ticket confirmations): true/false, default true; poll interval default 5 s.
CONGRESS_SMS_OUTBOX_ENABLED=
CONGRESS_SMS_OUTBOX_POLL_SECONDS=
# How often each API process re-reads settings saved in the platform console. Default 3 s.
CONGRESS_PLATFORM_SETTINGS_REFRESH_SECONDS=

# ── Sign-in codes and throttling (the platform console overrides the sign-in rules) ────────────────────
# Digits (6-8 in staging/production; default 6) and lifetime in seconds (60-600, default 120).
CONGRESS_OTP_LENGTH=
CONGRESS_OTP_TTL_SECONDS=
# Seconds before the same number may ask again (default 60); codes per number per hour (default 5); per client
# address per hour (default 100).
CONGRESS_OTP_RESEND_COOLDOWN_SECONDS=
CONGRESS_OTP_SENDS_PER_MOBILE_PER_HOUR=
CONGRESS_OTP_SENDS_PER_IP_PER_HOUR=
# Venue networks (comma-separated CIDRs, e.g. the congress Wi-Fi's public address) and their higher per-address
# budget (default 2000 per hour). Empty = none.
CONGRESS_OTP_TRUSTED_NETWORKS=
CONGRESS_OTP_SENDS_PER_TRUSTED_IP_PER_HOUR=
# Throttle repeated failed sign-ins / admin-token / API-key attempts: true/false, default true. Keep it on.
CONGRESS_AUTH_RATE_LIMITS_ENABLED=

# ── Database and uploads ──────────────────────────────────────────────────────────────────────────────
# Connections per API process: pool size (default 10) + overflow (default 10); keep the total below PostgreSQL's
# max_connections (100). A request waits at most POOL_TIMEOUT seconds (default 10) for one. PRE_PING (default true)
# tests each pooled connection first. STATEMENT_TIMEOUT_MS: PostgreSQL cancels longer statements (default 15000, 0 = none).
CONGRESS_DB_POOL_SIZE=
CONGRESS_DB_MAX_OVERFLOW=
CONGRESS_DB_POOL_TIMEOUT_SECONDS=
CONGRESS_DB_POOL_PRE_PING=
CONGRESS_DB_STATEMENT_TIMEOUT_MS=
# API worker processes (default 1, at most 32). More workers use more CPU cores; every worker opens its own pool,
# so keep CONGRESS_API_WORKERS x (POOL_SIZE + MAX_OVERFLOW) below max_connections (e.g. 4 workers with 5 + 5).
# Leave it at 1 while CONGRESS_SMS_PROVIDER=console (each worker keeps its own test outbox). See STAGING_OPERATIONS.md → Scaling.
CONGRESS_API_WORKERS=
# Largest accepted upload in bytes (default 5242880 = 5 MB, at most 20 MB; Caddy refuses bodies over 8 MB).
CONGRESS_MEDIA_MAX_BYTES=

# ── Data retention ────────────────────────────────────────────────────────────────────────────────────
# Removes used/expired sign-in codes after OTP_RETENTION_HOURS (default 24) and the text of sent SMS after
# SMS_BODY_RETENTION_DAYS (default 30), every RETENTION_INTERVAL_SECONDS (default 3600). Enabled by default.
CONGRESS_RETENTION_ENABLED=
CONGRESS_RETENTION_INTERVAL_SECONDS=
CONGRESS_OTP_RETENTION_HOURS=
CONGRESS_SMS_BODY_RETENTION_DAYS=
# Sign-in SMS log rows are deleted after OTP_SMS_LOG_RETENTION_DAYS (default 30); full numbers in the SMS log are
# masked after SMS_MOBILE_RETENTION_DAYS (default 90); expired short links are deleted SHORT_LINK_GRACE_DAYS
# (default 30) after they expire.
CONGRESS_OTP_SMS_LOG_RETENTION_DAYS=
CONGRESS_SMS_MOBILE_RETENTION_DAYS=
CONGRESS_SHORT_LINK_GRACE_DAYS=
# Audit log entries older than this many days (at least 180) may be purged, only by the explicit operator command
# `python -m app.retention purge-audit`. Empty (default): the audit log is kept forever.
CONGRESS_AUDIT_RETENTION_DAYS=

# ── Monitoring ────────────────────────────────────────────────────────────────────────────────────────
# JSON log lines unless CONGRESS_LOG_FORMAT=text. /api/metrics needs this bearer token (`stack.mjs init`
# generates one; empty = disabled) and a client address in CONGRESS_METRICS_ALLOW. Sentry/GlitchTip DSN optional.
CONGRESS_LOG_FORMAT=
CONGRESS_METRICS_TOKEN=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
CONGRESS_METRICS_ALLOW=private_ranges
CONGRESS_SENTRY_DSN=

# Off-host backups, point-in-time recovery (BACKUP_WAL=on), Telegram alerts and the heartbeat URL
# (ALERT_HEARTBEAT_URL): see deploy/hosted/.env.hosted.example. Off-host copies are always encrypted; set
# BACKUP_ENCRYPTION_KEY with the BACKUP_S3_* values.
