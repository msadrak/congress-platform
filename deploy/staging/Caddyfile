# Congress Platform edge. Serves the production SPA, proxies /api to FastAPI, terminates HTTPS.
#   CONGRESS_SITE_ADDRESS  e.g. https://localhost (local staging) or congress.example.org (real domain)
#   CONGRESS_TLS           "internal" (Caddy's local CA) or an e-mail address for Let's Encrypt/ZeroSSL
#   CONGRESS_LOCAL_HTTP    on  = also serve http://localhost (local staging); off = real domain, HTTP→HTTPS
#   CONGRESS_HSTS          on  = Strict-Transport-Security (real domain with a public certificate)
#   CONGRESS_ADMIN_ALLOW   client ranges that may reach /api/organizers and /api/platform through the proxy
#                          (local staging: private_ranges; hosted: 127.0.0.1/32 = nobody, use stack.mjs)
#   CONGRESS_DEFAULT_SNI   certificate name for clients that send no SNI, i.e. that connect to a bare IP
#                          address (LAN access: the machine's IP, which must also be in CONGRESS_SITE_ADDRESS)
# CDN in front (docs/deployment/CDN.md), all off by default:
#   CONGRESS_CDN           on  = read the visitor's address from CONGRESS_CLIENT_IP_HEADER, but only on connections
#                          from CONGRESS_TRUSTED_PROXIES (the CDN's address ranges, space separated)
#   CONGRESS_CDN_ONLY      on  = connections from anyone but the CDN get 403
#   CONGRESS_ORIGIN_TLS    off = plain-HTTP origin (CONGRESS_SITE_ADDRESS must then start with http://)
{
	admin off
	default_sni {$CONGRESS_DEFAULT_SNI:localhost}
	servers {
		protocols h1 h2
		import /etc/caddy/options/cdn-{$CONGRESS_CDN:off}.caddy
	}
}

(congress) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		?X-Frame-Options SAMEORIGIN
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
	import /etc/caddy/options/hsts-{$CONGRESS_HSTS:off}.caddy

	log {
		output stdout
		format filter {
			wrap json
			# Scanner pairing links carry a token in the query string; searches and the SMS outbox carry names and
			# mobile numbers. None of them belong in access logs.
			request>uri query {
				delete token
				delete q
				delete mobile
			}
			request>headers>Authorization delete
			request>headers>X-Admin-Token delete
		}
	}

	# With CONGRESS_CDN_ONLY=on, anyone but the CDN gets 403 here (before every other handler).
	import /etc/caddy/options/cdn-gate-{$CONGRESS_CDN_ONLY:off}.caddy

	handle /api/* {
		# A CDN must never cache API answers unless the API says so (public images and page heads do).
		header ?Cache-Control "no-store"

		# Platform administration (organizer provisioning and key lifecycle) is not for the public internet.
		@adminBlocked {
			path /api/organizers /api/organizers/* /api/platform/*
			not remote_ip {$CONGRESS_ADMIN_ALLOW:private_ranges}
		}
		respond @adminBlocked 404

		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000 {
			# The API throttles per visitor address and reads it from X-Forwarded-For: send exactly one value, the
			# one worked out above (the connecting address, or behind a trusted CDN the visitor's), never a list a
			# visitor could have written.
			header_up X-Forwarded-For {client_ip}
			# While the API restarts (deploys, rebuilds) hold requests briefly instead of failing them.
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Public congress and booth pages: the SPA shell with server-rendered <head> (published content only).
	@congress path /e/*
	handle @congress {
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /seo-shell.html
		templates {
			mime text/html
		}
		file_server
	}

	handle {
		root * /srv
		# Content-hashed bundles never change; everything else (index.html, sw.js, manifest) revalidates
		# so a new release replaces the application shell and the service worker promptly.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$CONGRESS_SITE_ADDRESS:https://localhost} {
	import /etc/caddy/options/origin-tls-{$CONGRESS_ORIGIN_TLS:on}.caddy
	import congress
}

# Container health check only: loopback inside the container, never published, identical in every edge mode
# (a hosted site has no plain-HTTP localhost site and no certificate for 127.0.0.1).
http://:8081 {
	bind 127.0.0.1
	handle /api/ready {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		file_server
	}
}

# Local staging only (CONGRESS_LOCAL_HTTP=on): plain HTTP on localhost, a secure context for browsers, for
# tools and test runners that cannot trust the local CA. Off for a real domain, where Caddy redirects
# every HTTP request to HTTPS.
import /etc/caddy/options/local-http-{$CONGRESS_LOCAL_HTTP:on}.caddy
