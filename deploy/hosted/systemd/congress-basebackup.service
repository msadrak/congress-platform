[Unit]
Description=Congress Platform pgBackRest base backup (point-in-time recovery, BACKUP_WAL=on)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=congress
WorkingDirectory=/opt/congress-platform
EnvironmentFile=-/etc/congress/backup.env
ExecStart=/usr/bin/node scripts/staging/stack.mjs base-backup
