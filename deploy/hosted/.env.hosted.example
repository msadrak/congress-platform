# Congress Platform — hosted (real domain) environment. On the server: copy to .staging/staging.env
# (the operations tool's file name is historical; it is git-ignored) and replace every <...>.
# Every setting the API reads is listed here (scripts/staging/stack.test.mjs checks it). A setting left empty means
# "use the default" given in its comment; values must be bare (no trailing comments).
CONGRESS_ENVIRONMENT=production

# Host persistent data (DrGibi-style). Example for root on the server:
# CONGRESS_PERSISTENT_DATA_ROOT=/root/congress-persistent-data
CONGRESS_PERSISTENT_DATA_ROOT=<set on server, e.g. /root/congress-persistent-data>

# Secrets: generate on the server, never reuse local staging values.
POSTGRES_PASSWORD=<generate: python3 -c "import secrets; print(secrets.token_hex(24))">
CONGRESS_PLATFORM_ADMIN_TOKEN=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
CONGRESS_JWT_SECRET=<generate: python3 -c "import secrets; print(secrets.token_hex(32))">
# Encrypts credentials stored in the database (the sms.ir key saved in the platform console); >= 32 chars, different
# from CONGRESS_JWT_SECRET. An existing server adds one with `stack.mjs init --add-missing` (values sealed before keep
# opening). Empty = a key derived from the JWT secret (not recommended).
CONGRESS_SECRET_BOX_KEY=<generate: python3 -c "import secrets; print(secrets.token_hex(32))">

# Public identity. Must be exactly the HTTPS origin visitors use (canonical links, og:url/og:image, CORS).
CONGRESS_PUBLIC_ORIGIN=https://<congress.example.org>
# Optional: origin of the pass links in SMS (`<origin>/t/<code>`, ADR 0015); empty = CONGRESS_PUBLIC_ORIGIN. Only for a
# shorter https domain served by this same deployment (also list it in CONGRESS_SITE_ADDRESS).
CONGRESS_SHORT_LINK_ORIGIN=
CONGRESS_SITE_ADDRESS=<congress.example.org>
# ACME account e-mail: Caddy obtains and renews a public certificate (ports 80 and 443 must reach the server).
CONGRESS_TLS=<ops@example.org>
# Real domain: no plain-HTTP localhost site (HTTP redirects to HTTPS); HSTS once the domain is final.
CONGRESS_LOCAL_HTTP=off
CONGRESS_HSTS=on
# Nobody reaches /api/organizers through the proxy; operators use `stack.mjs organizer …` on the server.
CONGRESS_ADMIN_ALLOW=127.0.0.1/32

# SMS through sms.ir (required in production): sign-in codes and ticket confirmations, sent as text from your
# service line (خط خدماتی). API key: sms.ir panel → developers → API keys. Both can instead be set in the
# platform console (/platform → SMS; reachable only from CONGRESS_ADMIN_ALLOW networks), which overrides these.
# The wording is edited in the app (organizer → SMS for each event; platform console for the shared texts).
CONGRESS_SMS_PROVIDER=smsir
# Optional here when they are set in the platform console instead.
CONGRESS_SMSIR_API_KEY=
CONGRESS_SMSIR_LINE_NUMBER=
# Seconds a send waits for sms.ir. Default 5.
CONGRESS_SMSIR_TIMEOUT_SECONDS=
# Platform-wide caps per rolling hour / day (0 = none; defaults 2000 / 20000); the platform console overrides them.
# `stack.mjs check` warns at 80 % and is critical at 100 % (sign-in codes are then refused).
CONGRESS_SMS_HOURLY_CAP=
CONGRESS_SMS_DAILY_CAP=
# Percent of each cap kept for sign-in codes, 0-90 (default 20): every other SMS stops at the rest.
CONGRESS_SMS_OTP_RESERVE_PERCENT=
# SMS notices from an attendee's own changes, per person per hour and per ticket per day (defaults 6 / 6), and
# from organizer changes, per organizer per hour (default 300; above it 429 SMS_NOTICE_LIMIT_REACHED).
CONGRESS_SMS_NOTICES_PER_ATTENDEE_PER_HOUR=
CONGRESS_SMS_NOTICES_PER_TICKET_PER_DAY=
CONGRESS_SMS_NOTICES_PER_ORGANIZER_PER_HOUR=
# Organizer test sends per organizer per 24 h (default 20); provider calls in flight per API process (default 8).
CONGRESS_SMS_TEST_SENDS_PER_ORGANIZER_PER_DAY=
CONGRESS_SMS_MAX_CONCURRENT_SENDS=
# Background delivery of queued confirmations: true/false (default true), poll interval (default 5 s).
CONGRESS_SMS_OUTBOX_ENABLED=
CONGRESS_SMS_OUTBOX_POLL_SECONDS=
# How often each API process re-reads platform console settings (default 3 s).
CONGRESS_PLATFORM_SETTINGS_REFRESH_SECONDS=

# Sign-in codes (the platform console overrides these rules): digits (6-8 here; default 6), lifetime (default 120 s),
# resend cooldown (default 60 s), codes per number per hour (default 5) and per client address per hour (default 100).
CONGRESS_OTP_LENGTH=
CONGRESS_OTP_TTL_SECONDS=
CONGRESS_OTP_RESEND_COOLDOWN_SECONDS=
CONGRESS_OTP_SENDS_PER_MOBILE_PER_HOUR=
CONGRESS_OTP_SENDS_PER_IP_PER_HOUR=
# The venue Wi-Fi's public address(es), comma-separated CIDRs, and their per-address budget (default 2000 per hour).
CONGRESS_OTP_TRUSTED_NETWORKS=
CONGRESS_OTP_SENDS_PER_TRUSTED_IP_PER_HOUR=
# Failed sign-in / admin-token / API-key throttling: true/false, default true. Keep it on.
CONGRESS_AUTH_RATE_LIMITS_ENABLED=

# Database connections per API process: pool (default 10) + overflow (default 10), wait for one at most 10 s,
# pre-ping on (default true), statement timeout 15000 ms (0 = none).
CONGRESS_DB_POOL_SIZE=
CONGRESS_DB_MAX_OVERFLOW=
CONGRESS_DB_POOL_TIMEOUT_SECONDS=
CONGRESS_DB_POOL_PRE_PING=
CONGRESS_DB_STATEMENT_TIMEOUT_MS=
# Largest accepted upload in bytes (default 5242880 = 5 MB, at most 20 MB).
CONGRESS_MEDIA_MAX_BYTES=

# Data retention: used/expired sign-in codes removed after 24 h, SMS texts after 30 days, checked hourly. Defaults on.
CONGRESS_RETENTION_ENABLED=
CONGRESS_RETENTION_INTERVAL_SECONDS=
CONGRESS_OTP_RETENTION_HOURS=
CONGRESS_SMS_BODY_RETENTION_DAYS=
# Sign-in SMS log rows deleted after 30 days, SMS-log numbers masked after 90, expired short links deleted 30 days
# after expiry. Audit log purge (at least 180 days) only via `python -m app.retention purge-audit`; empty = keep forever.
CONGRESS_OTP_SMS_LOG_RETENTION_DAYS=
CONGRESS_SMS_MOBILE_RETENTION_DAYS=
CONGRESS_SHORT_LINK_GRACE_DAYS=
CONGRESS_AUDIT_RETENTION_DAYS=

# CDN (ParsPack) in front of this server: do not edit by hand. `node scripts/staging/stack.mjs cdn parspack` and
# `cdn origin https|http` write CONGRESS_CDN, CONGRESS_TRUSTED_PROXIES, CONGRESS_CLIENT_IP_HEADER, CONGRESS_CDN_ONLY
# and CONGRESS_ORIGIN_TLS here. See docs/deployment/CDN.md.

# Certificate name for clients that send no SNI (connections to the bare IP).
CONGRESS_DEFAULT_SNI=<congress.example.org>
CONGRESS_BIND=0.0.0.0
CONGRESS_HTTPS_PORT=443
CONGRESS_HTTP_PORT=80
CONGRESS_IMAGE_TAG=hosted
# CONGRESS_APP_BUILD: release id built into the web bundle (scanner build label, version-drift warning). `stack.mjs up`
# sets it for every build (short commit, -dirty-<time> for uncommitted changes); do not set it here.

# Monitoring (docs/deployment/STAGING_OPERATIONS.md → Monitoring).
# Logs are JSON lines in production unless CONGRESS_LOG_FORMAT=text.
CONGRESS_LOG_FORMAT=
# Bearer token for Prometheus at /api/metrics; empty = endpoint disabled (404). `stack.mjs metrics` reads it locally.
CONGRESS_METRICS_TOKEN=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
# Addresses that may reach /api/metrics through Caddy at all: your Prometheus server (127.0.0.1/32 = nobody).
CONGRESS_METRICS_ALLOW=127.0.0.1/32
# Sentry or GlitchTip DSN for error reports (no personal data is sent); empty = off.
CONGRESS_SENTRY_DSN=

# ── Backups, point-in-time recovery and alerts ─────────────────────────────────────────────────────
# Keep everything below in /etc/congress/backup.env instead (owner root, group congress, mode 640): stack.mjs and the
# systemd units read it, so these credentials do not sit beside the application secrets.
#
# Off-host copies (any S3-compatible store). Every file is encrypted on this server before upload (rclone crypt for
# the nightly backups, pgBackRest aes-256-cbc for WAL), with BACKUP_ENCRYPTION_KEY. Store that key in your password
# manager too: without it no off-host copy can be restored. Changing it later needs a new BACKUP_S3_PREFIX.
# BACKUP_S3_ENDPOINT=https://<s3.provider.example>
# BACKUP_S3_REGION=<region>
# BACKUP_S3_BUCKET=<bucket>
# BACKUP_S3_PREFIX=congress-production
# BACKUP_S3_ACCESS_KEY_ID=<key limited to that bucket/prefix>
# BACKUP_S3_SECRET_ACCESS_KEY=<secret>
# BACKUP_ENCRYPTION_KEY=<generate: openssl rand -base64 48>
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_MAX_AGE_HOURS=26
# During `stack.mjs event-mode on` (hourly backups) a backup older than this is critical.
BACKUP_EVENT_MAX_AGE_HOURS=2
#
# Point-in-time recovery (continuous WAL archiving with pgBackRest to the same bucket, under <prefix>/pgbackrest;
# needs the BACKUP_S3_* and BACKUP_ENCRYPTION_KEY above). Then `stack.mjs up` and `sudo stack.mjs install-timers`.
#   ARCHIVE_TIMEOUT: seconds; the most recent data that can be lost (RPO) while anything is being written.
#   RETENTION_FULL: full base backups kept, with their WAL (the recovery window). FULL_DAYS: base-backup takes a full
#   backup when the newest is older, a differential otherwise. MAX_AGE_HOURS: `check` limit for the last base backup.
#   (Values must be bare: systemd and stack.mjs do not strip trailing comments.)
# BACKUP_WAL=on
# BACKUP_WAL_ARCHIVE_TIMEOUT=60
# BACKUP_WAL_RETENTION_FULL=2
# BACKUP_WAL_FULL_DAYS=7
# BACKUP_WAL_MAX_AGE_HOURS=26
#
# Alerts from `stack.mjs check` (systemd congress-check.timer, every 5 min): one Telegram message per new problem,
# a reminder every ALERT_REPEAT_HOURS while it lasts, one when it is resolved. Bot: @BotFather; chat id: the group or
# user the bot writes to. ALERT_TELEGRAM_API: a relay with the same API where api.telegram.org is unreachable.
# ALERT_TELEGRAM_BOT_TOKEN=<bot token>
# ALERT_TELEGRAM_CHAT_ID=<chat id>
# ALERT_TELEGRAM_API=https://api.telegram.org
# ALERT_REPEAT_HOURS=6
#
# Dead man's switch: `check` requests this URL after every run that found nothing critical (a healthchecks.io or
# Uptime Kuma "push" URL; free tiers suffice). That service alerts when the pings stop: server down, Docker hung, timer
# broken, or a critical problem that lasts. Pair it with an external uptime check of https://<domain>/api/ready.
# ALERT_HEARTBEAT_URL=https://hc-ping.com/<uuid>
#
# `check` thresholds: queued SMS waiting longer than LAG_MINUTES is a warning, longer than LAG_CRITICAL_MINUTES
# critical; failed + unconfirmed SMS above FAILED_MAX a warning; the certificate a warning below CERT_WARN_DAYS.
# ALERT_SMS_LAG_MINUTES=10
# ALERT_SMS_LAG_CRITICAL_MINUTES=30
# ALERT_SMS_FAILED_MAX=0
# ALERT_CERT_WARN_DAYS=14
