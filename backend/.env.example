# Copy to backend/.env for local development only. Never commit real values.
#
# CONGRESS_ENVIRONMENT selects the safety level; when unset the API assumes `production`.
#   development / test: missing CONGRESS_DATABASE_URL and CONGRESS_MEDIA_ROOT fall back to local defaults.
#   staging / production: CONGRESS_DATABASE_URL, CONGRESS_MEDIA_ROOT (absolute path on a durable volume) and a
#   generated admin token of 32+ characters are required; the placeholders below are refused at startup.
CONGRESS_ENVIRONMENT=development
CONGRESS_DATABASE_URL=postgresql+asyncpg://congress:congress@localhost:5433/congress
# Page Studio uploads. Defaults to backend/var/media in development.
# CONGRESS_MEDIA_ROOT=/srv/congress/media
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONGRESS_PLATFORM_ADMIN_TOKEN=change-me-in-production
CONGRESS_JWT_SECRET=replace-me-with-a-generated-secret-of-32-plus-characters
CONGRESS_CORS_ORIGINS=["http://localhost:5173"]
